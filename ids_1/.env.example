# Скопируйте файл в .env и заполните DB_PASSWORD.
# Для новой локальной базы пароль можно сгенерировать командой openssl rand -hex 24.
# Для существующей базы укажите её текущие DB_USER и DB_PASSWORD.

# Приложение
APP_PORT=8080

# Подключение к БД изнутри сети контейнеров
DB_HOST=db
DB_PORT=5432
DB_USER=irvs_local
DB_PASSWORD=
DB_NAME=app
DB_SSLMODE=disable

# Порты на хосте
APP_EXPOSED_PORT=8080
DB_EXPOSED_PORT=5432
