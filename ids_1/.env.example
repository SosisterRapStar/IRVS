# Скопируй в .env: файл целиком прокидывается в контейнер приложения (env_file),
# а docker compose берёт из него значения для подстановки в docker-compose.yml.

# Приложение
APP_PORT=8080

# Подключение к БД изнутри сети контейнеров
DB_HOST=db
DB_PORT=5432
DB_USER=app
DB_PASSWORD=app
DB_NAME=app

# Порты на хосте
APP_EXPOSED_PORT=8080
DB_EXPOSED_PORT=5432
